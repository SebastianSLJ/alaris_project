---
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import Pic from "../ui/Pic.astro";
import { solutions } from "../../content/home";
---

<section id={solutions.id} aria-labelledby="solutions-title" data-theme="light" class="py-20 lg:py-28">
  <div class="container-x">
    <SectionHeading id="solutions-title" title={solutions.title} description={solutions.description} />

    <div class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-2 lg:gap-8">
      {
        solutions.cards.map((card, i) => (
          <div data-reveal style={`--d:${i * 120}ms`}>
            <article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-elevated transition-all duration-300 hover:-translate-y-1 hover:border-field hover:shadow-card">
              <!-- product stage -->
              <div class="relative flex aspect-[16/11] items-end justify-center overflow-hidden bg-[radial-gradient(ellipse_at_50%_35%,var(--bg)_0%,color-mix(in_srgb,var(--border)_70%,var(--bg))_70%)] px-8 pt-8">
                <span
                  aria-hidden="true"
                  class="absolute bottom-6 left-1/2 h-6 w-[60%] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,color-mix(in_srgb,var(--shadow-color)_28%,transparent)_0%,transparent_70%)] blur-[4px]"
                />
                <Pic
                  src={card.image}
                  alt={card.imageAlt}
                  widths={[480, 720, 1000]}
                  sizes="(min-width: 1024px) 560px, 100vw"
                  class="relative mb-8 h-full w-full object-contain object-bottom transition-transform duration-500 ease-out group-hover:scale-[1.04]"
                />
              </div>

              <div class="flex flex-1 flex-col p-7 lg:p-9">
                <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">{card.category}</p>
                <h3 class="mt-3 font-display text-3xl font-medium leading-[1.1] tracking-[-0.01em] text-fg lg:text-[34px]">
                  {card.title}
                </h3>
                <p class="mt-3 max-w-[460px] text-base leading-[1.55] text-fg-muted">{card.description}</p>

                <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
                  <Button href={card.primary.href} interest={card.primary.interest} icon="cube" iconEnd="arrow-right">
                    {card.primary.label}
                  </Button>
                  <a
                    href={card.secondary.href}
                    data-interest={card.secondary.interest}
                    class="group/link inline-flex items-center gap-1.5 text-[15px] font-semibold text-accent hover:text-accent-fill-hover"
                  >
                    <span class="underline decoration-accent/30 underline-offset-4 group-hover/link:decoration-current">
                      {card.secondary.label}
                    </span>
                  </a>
                </div>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <p data-reveal class="mt-6 text-sm text-fg-muted">{solutions.note}</p>
  </div>
</section>
