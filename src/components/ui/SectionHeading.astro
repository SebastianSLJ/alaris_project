---
/* Section title with its description stacked right below, left-aligned. */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  id?: string;
  class?: string;
}

const { eyebrow, title, description, id, class: className = "" } = Astro.props;
---

<div class:list={["flex max-w-[880px] flex-col gap-5", className]}>
  <div data-reveal>
    {
      eyebrow && (
        <p class="mb-4 flex items-center gap-3 text-[13px] font-semibold uppercase tracking-[0.14em] text-accent">
          <span aria-hidden="true" class="h-px w-8 bg-current opacity-60" />
          {eyebrow}
        </p>
      )
    }
    <h2
      id={id}
      class="font-display text-4xl font-medium leading-[1.05] tracking-[-0.02em] text-fg lg:text-[52px]"
    >
      {title}
    </h2>
  </div>
  {
    description && (
      <p data-reveal style="--d:100ms" class="max-w-[620px] text-lg leading-[1.55] text-fg-muted">
        {description}
      </p>
    )
  }
</div>
