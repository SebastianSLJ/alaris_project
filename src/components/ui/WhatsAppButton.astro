---
import Icon from "./Icon.astro";
import { whatsapp } from "../../content/home";

const href = `https://wa.me/${whatsapp.number}?text=${encodeURIComponent(whatsapp.message)}`;
---

<div class="fixed bottom-6 right-6 z-40">
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={whatsapp.label}
    class="group relative flex h-14 w-14 items-center justify-center rounded-full wa-btn transition-transform duration-200 hover:scale-105 focus-visible:outline-offset-4"
  >
    <!-- pulse ring -->
    <span
      aria-hidden="true"
      class="wa-pulse wa-btn absolute inset-0 rounded-full"
      style="animation: wa-pulse 2.4s ease-out infinite"></span>
    <Icon name="whatsapp" size={30} class="relative" />

    <!-- tooltip -->
    <span
      role="tooltip"
      data-theme="dark"
      class="pointer-events-none absolute right-[calc(100%+12px)] top-1/2 -translate-y-1/2 whitespace-nowrap rounded-lg bg-elevated px-3 py-2 text-sm font-medium text-fg opacity-0 shadow-float transition-opacity duration-150 group-hover:opacity-100 group-focus-visible:opacity-100"
    >
      {whatsapp.tooltip}
    </span>
  </a>
</div>

<style>
  /* third-party brand color (WhatsApp green), defined once as the --whatsapp primitive */
  .wa-btn {
    background-color: var(--whatsapp);
    color: var(--white);
  }
  a.wa-btn {
    box-shadow: 0 8px 24px color-mix(in srgb, var(--whatsapp) 40%, transparent);
  }
</style>
